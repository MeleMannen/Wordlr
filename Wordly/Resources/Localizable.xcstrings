          }
        }
      }
    },
    "To play the game, just enter a valid word and submit your guess. After each guess, the colors of the tiles will show how close you were." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para jugar, introduce una palabra válida y envía tu intento. Tras cada intento, los colores indicarán lo cerca que estuviste."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For å spille, bare skriv et gyldig ord og gjett ordet. Etter hver gjetning vil fargene vil vise hvor nærme du var."
          }
        }
      }
    },
