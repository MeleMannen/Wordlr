    "Game clues automatically fills in filter options based on your current game progress. Upgrade to Pro in Settings to unlock this feature.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Game clues automatically fills in filter options based on your current game progress. Upgrade to Pro in Settings to unlock this feature."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las pistas del juego rellenan automáticamente las opciones de filtro según tu progreso actual. Mejora a Pro en Ajustes para desbloquear esta función."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Spillets ledetråder fyller automatisk inn filteralternativene basert på din nåværende spillprogresjon. Oppgrader til Pro i Innstillinger for å låse opp denne funksjonen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les indices de jeu remplissent automatiquement les options de filtre selon votre progression actuelle. Passez à Pro dans Réglages pour déverrouiller cette fonctionnalité."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wskazówki z gry automatycznie uzupełniają filtry na podstawie bieżącego postępu. Przejdź na Pro w Ustawieniach, aby odblokować tę funkcję."
          }
        }
      }
    },
