    "%@ is a word game where you guess a secret word. The game provides feedback on your guesses, indicating correct letters and their positions.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is a word game where you guess a secret word. The game provides feedback on your guesses, indicating correct letters and their positions."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ es un juego de palabras en el que debes adivinar una palabra secreta. El juego te da retroalimentación sobre tus intentos, indicando las letras correctas y sus posiciones."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ er et ordspill hvor du gjetter et hemmelig ord. Spillet gir tilbakemelding på gjettene dine, og indikerer riktige bokstaver og deres posisjoner."
          }
        }
      }
    },
