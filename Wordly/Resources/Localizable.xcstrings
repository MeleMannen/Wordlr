            "value": "Ya has jugado esta palabra"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du har allerede spillt dette ordet"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez déjà joué ce mot"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To słowo zostało już zagrane"
          }
        }
      }
    },
    "You will lose your word and you cannot undo this action": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You will lose your word and you cannot undo this action"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Perderás tu palabra y no podrás deshacer esta acción"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du mister ordet ditt, og du kan ikke angre denne handlingen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous perdrez votre mot et vous ne pourrez pas annuler cette action"
