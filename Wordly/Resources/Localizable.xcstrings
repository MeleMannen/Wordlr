    "You have already played this exact word today. Are you sure you want to play the same word again?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You have already played this exact word today. Are you sure you want to play the same word again?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya has jugado exactamente esta palabra hoy. ¿seguro que quieres jugar la misma palabra otra vez?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du har allerede gjette dette ordet i dag. Er du sikker på at du vil gjette det samme ordet igjen?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez déjà joué exactement ce mot aujourd’hui. Voulez-vous vraiment rejouer le même mot ?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dzisiaj grano już dokładnie tym słowem. Czy na pewno chcesz zagrać tym samym słowem ponownie?"
          }
        }
      }
    },
    "You have already played this word": {
      "localizations": {
        "en": {
