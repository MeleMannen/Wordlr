    "Remember to play today's %d letter, %@ daily Wordlr to not lose your %d🔥 day streak.": {
      "comment": "Body for Daily Wordlr streak reminder notification",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remember to play today's %d letter, %@ daily Wordlr to not lose your %d🔥 day streak."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recuerda jugar hoy la Palabra Diaria de %d letras en %@ para no perder tu racha de %d🔥 días."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Husk å spille dagens %d bokstaver, %@ Dagens Ord, så du ikke mister streaken din på %d🔥 dager."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pensez à jouer au Wordlr quotidien de %d lettres en %@ aujourd’hui pour ne pas perdre votre série de %d🔥 jours."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pamiętaj, aby zagrać dziś w Codzienny Wordlr z %d literami w języku %@ i nie stracić serii %d🔥 dni."
          }
        }
      }
    },
