    },
    "The Normal mode allows you to play as many times as you want, while the Daily Word mode provides a unique word each day, that is the same for all players." : {
      "extractionState" : "stale",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El modo Normal te permite jugar tantas veces como quieras, mientras que el modo Palabra Diaria ofrece una palabra única cada día, que es la misma para todos los jugadores."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Normal modus lar deg spille så mange ganger du vil, mens Daglig Ord-modusen gir et unikt ord hver dag, som er det er det samme for alle spillere."
          }
        }
      }
    },
    "The Phrase" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Phrase"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Phrase"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Phrase"
          }
        }
      }
    },
    "The Phrase is a word game where you guess a secret word by entering letters. The game provides feedback on your guesses, indicating correct letters and their positions." : {
      "extractionState" : "stale",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Phrase es un juego de palabras en el que adivinas una palabra secreta ingresando letras. El juego proporciona retroalimentación sobre tus adivinar, indicando las letras correctas y sus posiciones."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Phrase er et ordspill der du får et hemmelig ord, og skal prøve å gjette det. Spillet gir tilbakemelding på gjetningene dine. Det indikerer riktige bokstaver og deres posisjoner."
          }
        }
      }
    },
    "The Phrase Was: %@!" : {
      "localizations" : {
        "en" : {
