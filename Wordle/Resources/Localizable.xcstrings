    "We couldn't find a definition for this Phrase. That might be because it is a name or a place name." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We couldn't find a definition for this Phrase. That might be because it is a name or a place name."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No pudimos encontrar una definición para esta Frase. Esto podría deberse a que es un nombre propio o un nombre de lugar."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vi kunne ikke finne en definisjon for denne Frasen. Det kan være fordi det er et navn eller stedsnavn. "
          }
        }
      }
    },
    "We couldn't find a definition for this Word. That might be because it is a name or a place name." : {
