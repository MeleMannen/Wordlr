    "Remember to play today's %d letter, %@ daily word to not lose your %d🔥 day streak." : {
      "comment" : "Body for daily word streak reminder notification",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remember to play today's %d-letter word in %@ to keep your %d🔥 day streak."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recuerda jugar hoy la palabra diaria de %d letras en %@ para no perder tu racha de %d🔥 días."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pensez à jouer au mot quotidien de %d lettres en %@ aujourd’hui pour conserver votre série de %d🔥 jours."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
